{
  "manifest_version": 3,
  "name": "Doc Rephrase",
  "version": "3.0.0",
  "description": "Highlight text in any Google Doc, press a shortcut, and get a Claude rewrite in the side panel.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "offscreen",
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Rephrase the highlighted text"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      }
    }
  },
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
